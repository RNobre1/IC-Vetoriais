# datasets brutos — volume grande, não versionar
data/

# python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# locks de office (LibreOffice/Word)
.~lock.*#

# obsidian — workspace local do usuário, não compartilhar
vault/.obsidian/workspace*
vault/.obsidian/cache/
.obsidian/
.trash/

# vault/papers — fichamentos .md versionados; PDFs/HTML/_files ignorados (volume + direitos autorais)
vault/papers/*.pdf
vault/papers/*.html
vault/papers/*_files/

# editores / SO
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# logs / artefatos de benchmark
*.log
results/

# Exceção: os JSONs de resultado de benchmark SÃO o dado científico do trabalho.
# Sem eles versionados, nenhum número do relatório é rastreável até a fonte e a
# reprodutibilidade que o próprio relatório afirma não existe. São ~80 KB.
!code/results/
code/results/*
!code/results/*.json

# Sessões de medição: ambiente, progresso, marcos de fase, logs, o CSV do
# amostrador de recursos e as janelas brutas do Cenário C. Sustentam a
# atribuição de memória, CPU e swap a cada fase e o cálculo do recall sob
# escrita (vide vault/decisões/2026-11-15-protocolo-da-sessao-final.md).
!code/results/sessoes/
!code/results/sessoes/**
